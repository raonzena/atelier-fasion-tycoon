rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'state', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.state is map
        && request.resource.data.state.companyName is string
        && request.resource.data.state.companyName.size() <= 20
        && request.resource.data.state.placed is list
        && request.resource.data.state.placed.size() <= 100;
      allow delete, list: if false;
    }
  }
}
